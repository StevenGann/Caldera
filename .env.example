# ─── Caldera configuration ─────────────────────────────────────────────
# Copy to .env and fill in. All vars are prefixed CALDERA_.

# API authentication — comma-separated Bearer keys the API will accept.
CALDERA_API_KEYS=changeme-dev-key
# To run with NO authentication (trusted network only) you must opt in explicitly;
# otherwise Caldera refuses to start when no keys are set.
CALDERA_ALLOW_NO_AUTH=false

# Set true to reject every mutating request and disable pushing.
CALDERA_READ_ONLY=false

# ─── Vault source ──────────────────────────────────────────────────────
# One of: github | local
CALDERA_SOURCE=github

# Where the working tree lives inside the container.
CALDERA_VAULT_PATH=/vault

# GitHub private-repo source
CALDERA_GITHUB_REPO=owner/your-vault
CALDERA_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
CALDERA_GITHUB_BRANCH=main

# ─── Sync loop (debounced flusher + reconcile, DESIGN §5/§7) ────────────
# Poll/reconcile interval in seconds. 0 disables periodic polling.
CALDERA_SYNC_INTERVAL=60
# Debounced commit/push: a flush fires after DEBOUNCE seconds of write-quiet,
# or MAX_WAIT seconds after the first pending write — whichever comes first.
# Keep MAX_WAIT <= SYNC_INTERVAL so the un-pushed window never outlasts a poll.
CALDERA_COMMIT_DEBOUNCE=10
CALDERA_COMMIT_MAX_WAIT=30
# Consecutive push failures before /vault/status.state becomes "push_wedged".
CALDERA_PUSH_WEDGED_AFTER=5

# Git identity used for Caldera-authored commits.
CALDERA_GIT_AUTHOR_NAME=Caldera
CALDERA_GIT_AUTHOR_EMAIL=caldera@localhost

# ─── Search ────────────────────────────────────────────────────────────
# Keyword (fuzzy) search is always on. Min match score 0–100.
CALDERA_SEARCH_FUZZY_THRESHOLD=60
# Opt-in local semantic/vector search (downloads a ~130MB ONNX model on first run).
CALDERA_SEMANTIC_SEARCH=false
CALDERA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Fall back to keyword while semantic is disabled/warming (else mode=semantic → 409).
CALDERA_SEMANTIC_FALLBACK=true
# Caldera state OUTSIDE the vault working tree (vectors.db). Never under VAULT_PATH.
CALDERA_DATA_PATH=/data

# Max note size in bytes (writes over this → 413).
CALDERA_MAX_NOTE_BYTES=5242880

# ─── MCP ───────────────────────────────────────────────────────────────
# Mount the MCP server at /mcp (Streamable HTTP, same Bearer keys).
CALDERA_MCP_ENABLED=true

# ─── Webhook (notify an agent on external vault changes) ────────────────
# POST a vault.updated event here when a pull brings in external changes.
# Unset to disable. See docs/WEBHOOKS.md.
# CALDERA_WEBHOOK_URL=https://hermes.example/caldera-hook
# CALDERA_WEBHOOK_SECRET=a-long-random-shared-secret
CALDERA_WEBHOOK_TIMEOUT=10

# ─── Real-time change stream (SSE /events, poll /changes) ───────────────
# Drives clients like the Caldera-Sync Obsidian plugin. See docs/REALTIME_SYNC.md.
# Number of recent changes retained for replay/catch-up after a reconnect.
CALDERA_EVENTS_BUFFER_SIZE=1000
# Seconds between SSE keepalive comments (holds the connection open).
CALDERA_EVENTS_KEEPALIVE=25

# ─── Server ────────────────────────────────────────────────────────────
CALDERA_HOST=0.0.0.0
CALDERA_PORT=8000
CALDERA_LOG_LEVEL=info
# CORS origins allowed to call the API from a browser (the Obsidian plugin's
# SSE stream is CORS-checked). Comma-separated; "*" allows any. Defaults cover
# Obsidian desktop (app://obsidian.md) and mobile (capacitor://localhost, http://localhost).
# CALDERA_CORS_ORIGINS=app://obsidian.md,capacitor://localhost,http://localhost
