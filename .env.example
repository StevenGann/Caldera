# ─── Caldera configuration ─────────────────────────────────────────────
# Copy to .env and fill in. All vars are prefixed CALDERA_.

# API authentication — comma-separated Bearer keys the API will accept.
CALDERA_API_KEYS=changeme-dev-key

# Set true to reject every mutating request and disable pushing.
CALDERA_READ_ONLY=false

# ─── Vault source ──────────────────────────────────────────────────────
# One of: github | local
CALDERA_SOURCE=github

# Where the working tree lives inside the container.
CALDERA_VAULT_PATH=/vault

# GitHub private-repo source
CALDERA_GITHUB_REPO=owner/your-vault
CALDERA_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
CALDERA_GITHUB_BRANCH=main

# ─── Sync loop (debounced flusher + reconcile, DESIGN §5/§7) ────────────
# Poll/reconcile interval in seconds. 0 disables periodic polling.
CALDERA_SYNC_INTERVAL=60
# Debounced commit/push: a flush fires after DEBOUNCE seconds of write-quiet,
# or MAX_WAIT seconds after the first pending write — whichever comes first.
# Keep MAX_WAIT <= SYNC_INTERVAL so the un-pushed window never outlasts a poll.
CALDERA_COMMIT_DEBOUNCE=10
CALDERA_COMMIT_MAX_WAIT=30
# Consecutive push failures before /vault/status.state becomes "push_wedged".
CALDERA_PUSH_WEDGED_AFTER=5

# Git identity used for Caldera-authored commits.
CALDERA_GIT_AUTHOR_NAME=Caldera
CALDERA_GIT_AUTHOR_EMAIL=caldera@localhost

# ─── Server ────────────────────────────────────────────────────────────
CALDERA_HOST=0.0.0.0
CALDERA_PORT=8000
CALDERA_LOG_LEVEL=info
